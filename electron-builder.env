BUNDLING=true

# Use a local cache directory for electron artifacts to avoid re-downloading on every build.
# electron-download (used by electron-builder) respects the ELECTRON_CACHE env var.
# Set this to an absolute path or a workspace-relative path. Example uses a hidden cache folder in the repo.
ELECTRON_CACHE=.cache/electron

# If you have a local HTTP mirror for electron releases, set ELECTRON_MIRROR to its base URL.
# Example: ELECTRON_MIRROR=http://local-mirror.example.com/electron/
# ELECTRON_MIRROR=

# Prevent downloading Electron binaries during build. Set this to '1' or 'true' when
# you provide Electron artifacts via the cache (`ELECTRON_CACHE`) or a local mirror
# (`ELECTRON_MIRROR`). Note: when skipping downloads you must ensure the required
# Electron artifacts are already present in the cache or provided by the mirror.
# For npm-based install steps also set the npm config variant.
ELECTRON_SKIP_DOWNLOAD=1
NPM_CONFIG_ELECTRON_SKIP_DOWNLOAD=1
